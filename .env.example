# Space Explorer module configuration. Every variable is optional; defaults are shown.
# Copy to .env only if your process manager loads it; the server itself reads the process environment.

# HTTP port and bind address of the standalone server.
PORT=3000
HOST=0.0.0.0

# URL prefix when the module is served under a sub-path of a shared domain, e.g. /space-explorer
ORBIT_BASE_PATH=/

# Where research notes are kept.
#   browser (default): each visitor's notes stay in their own browser (localStorage). Nothing is stored
#                      on the server and the /api/v1/notebook and /api/v1/exports endpoints answer 403.
#   server:            one shared JSON notebook on the server. ANYONE who can reach the module can read
#                      and edit it, so enable this only behind your platform's authentication
#                      (reverse proxy / gateway). Never put credentials in the frontend.
ORBIT_NOTEBOOK_MODE=browser

# Used only when ORBIT_NOTEBOOK_MODE=server: directory for the notebook and export-log JSON files.
ORBIT_DATA_DIR=./data

# Pages allowed to embed the UI in an iframe (CSP frame-ancestors). Space-separated.
# Example: 'self' https://platform.example.org
ORBIT_FRAME_ANCESTORS='self'

# Origins allowed to call the REST API from browser code on another origin. Comma-separated, exact origins.
# Example: https://platform.example.org,http://localhost:5173
ORBIT_CORS_ORIGINS=

# How long (seconds) a NASA Exoplanet Archive answer is reused. 0 disables caching.
ORBIT_TAP_CACHE_TTL_SECONDS=600

# Contact added to the User-Agent sent to NASA and CDS, e.g. team@example.org
ORBIT_CONTACT=

# Override the NASA TAP endpoint only for a mirror or for tests.
# ORBIT_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync

# Directory of the built UI (default ./dist). Production only.
# ORBIT_STATIC_DIR=./dist
